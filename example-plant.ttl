@prefix ex: <https://example.org/example-water/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:AirSuppliedBy owl:inverseOf ex:SuppliesAir .

ex:FILTER_01_AIT a ex:Instrument ;
    ex:InstalledAt ex:FILTER_01 ;
    ex:Monitors ex:FILTER_01 .

ex:FILTER_02 a ex:Filter ;
    ex:Feeds ex:CLEARWELL ;
    ex:PartOf ex:FILTRATION .

ex:FedBy owl:inverseOf ex:Feeds .

ex:Governs owl:inverseOf ex:GovernedBy .

ex:HasPart owl:inverseOf ex:PartOf .

ex:Hosts owl:inverseOf ex:InstalledAt .

ex:MonitoredBy owl:inverseOf ex:Monitors .

ex:ProtectedBy owl:inverseOf ex:Protects .

ex:Shows owl:inverseOf ex:ShownOn .

ex:SubjectOf owl:inverseOf ex:Concerns .

ex:SuppliedBy owl:inverseOf ex:Supplies .

ex:VerificationRecord a owl:Class ;
    rdfs:subClassOf ex:Record .

ex:WO_0001 a ex:WorkOrder ;
    ex:Concerns ex:AIR_COMPRESSOR .

ex:AIR_COMPRESSOR a ex:Compressor ;
    ex:PartOf ex:HIGH_LIFT ;
    ex:ShownOn ex:DWG_HL_001 ;
    ex:SuppliesAir ex:SURGE_VESSEL .

ex:Asset a owl:Class .

ex:Compressor a owl:Class ;
    rdfs:subClassOf ex:Equipment .

ex:Concerns a owl:ObjectProperty .

ex:Drawing a owl:Class ;
    rdfs:subClassOf ex:Record .

ex:Feeds a owl:ObjectProperty .

ex:GovernedBy a owl:ObjectProperty .

ex:HLP_01 a ex:Pump ;
    ex:Feeds ex:MAIN_A ;
    ex:PartOf ex:HIGH_LIFT .

ex:HLP_02 a ex:Pump ;
    ex:Feeds ex:MAIN_A ;
    ex:PartOf ex:HIGH_LIFT .

ex:InstalledAt a owl:ObjectProperty .

ex:Instrument a owl:Class ;
    rdfs:subClassOf ex:Asset .

ex:MAINS_A a ex:Area ;
    ex:PartOf ex:TRANSMISSION_A .

ex:Main a owl:Class ;
    rdfs:subClassOf ex:Equipment .

ex:Monitors a owl:ObjectProperty .

ex:Network a owl:Class ;
    rdfs:subClassOf ex:Location .

ex:PartOf a owl:ObjectProperty .

ex:PressureZone a owl:Class ;
    rdfs:subClassOf ex:Location .

ex:Procedure a owl:Class ;
    rdfs:subClassOf ex:Record .

ex:Protects a owl:ObjectProperty .

ex:RESERVOIR_A a ex:Reservoir ;
    ex:PartOf ex:STORAGE_A ;
    ex:Supplies ex:ZONE_A .

ex:SOP_SURGE_01 a ex:Procedure .

ex:STATION_A a ex:Site .

ex:STORAGE_A a ex:Area ;
    ex:PartOf ex:STATION_A .

ex:SURGE_VESSEL a ex:SurgeVessel ;
    ex:GovernedBy ex:SOP_SURGE_01 ;
    ex:PartOf ex:HIGH_LIFT ;
    ex:Protects ex:MAIN_A ;
    ex:ShownOn ex:DWG_HL_001 .

ex:ShownOn a owl:ObjectProperty .

ex:Supplies a owl:ObjectProperty .

ex:SuppliesAir a owl:ObjectProperty .

ex:SurgeVessel a owl:Class ;
    rdfs:subClassOf ex:Equipment .

ex:TRANSMISSION_A a ex:Network .

ex:WorkOrder a owl:Class ;
    rdfs:subClassOf ex:Record .

ex:ZONE_A a ex:PressureZone .

ex:CLEARWELL a ex:Reservoir ;
    ex:Feeds ex:HLP_01,
        ex:HLP_02 ;
    ex:PartOf ex:HIGH_LIFT .

ex:DWG_HL_001 a ex:Drawing .

ex:EXAMPLE_WTP a ex:Site .

ex:FILTER_01 a ex:Filter ;
    ex:Feeds ex:CLEARWELL ;
    ex:PartOf ex:FILTRATION .

ex:FILTRATION a ex:Area ;
    ex:PartOf ex:EXAMPLE_WTP .

ex:Filter a owl:Class ;
    rdfs:subClassOf ex:Equipment .

ex:Function a owl:Class .

ex:Pump a owl:Class ;
    rdfs:subClassOf ex:Equipment .

ex:Reservoir a owl:Class ;
    rdfs:subClassOf ex:Equipment .

ex:Site a owl:Class ;
    rdfs:subClassOf ex:Location .

ex:Location a owl:Class .

ex:MAIN_A a ex:Main ;
    ex:Feeds ex:RESERVOIR_A ;
    ex:PartOf ex:MAINS_A .

ex:Area a owl:Class ;
    rdfs:subClassOf ex:Function .

ex:Record a owl:Class .

ex:HIGH_LIFT a ex:Area ;
    ex:PartOf ex:EXAMPLE_WTP .

ex:Equipment a owl:Class ;
    rdfs:subClassOf ex:Function .

